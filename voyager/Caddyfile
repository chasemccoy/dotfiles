archive.chsmc.tools {
	root * /Users/voyager/Archives
	file_server browse
	import cloudflare
}

# iOS builds from ios-ship (scripts/skills/ios-ship): install pages, manifests and .ipa files.
builds.chsmc.tools {
	root * /Users/voyager/ios-builds/www
	@manifest path *.plist
	header @manifest Content-Type "text/xml; charset=utf-8"
	@ipa path *.ipa
	header @ipa Content-Type "application/octet-stream"
	@log path *.log
	header @log Content-Type "text/plain; charset=utf-8"
	file_server
	import cloudflare
}

# Agent-made HTML artifacts (the artifacts repo). Tailnet only: the gallery edits and commits without auth.
artifacts.chsmc.tools {
	@outside not remote_ip 100.64.0.0/10 fd7a:115c:a1e0::/48
	respond @outside 403
	reverse_proxy http://127.0.0.1:5004
	import cloudflare
}

familiar.chsmc.tools {
	# Tailnet only: refuse anything that didn't come over Tailscale. No encode: the event stream must not be compressed.
	@outside not remote_ip 100.64.0.0/10 fd7a:115c:a1e0::/48
	respond @outside 403
	reverse_proxy http://127.0.0.1:4848 {
		flush_interval -1
	}
	import cloudflare
}

faulkner.chsmc.tools {
	# Faulkner's web app (vite dev on 1897). Tailnet only: it commits and pushes to the public blog.
	@outside not remote_ip 100.64.0.0/10 fd7a:115c:a1e0::/48
	respond @outside 403
	reverse_proxy localhost:1897
	import cloudflare
}

